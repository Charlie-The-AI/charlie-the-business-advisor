{
  "name": "charlie-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Charlie the Business Advisor Monorepo",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm -r --filter='./packages/*' run test",
    "test:watch": "pnpm -r --filter='./packages/*' run test:watch",
    "typecheck": "pnpm -r --filter='./packages/*' run typecheck",
    "lint": "pnpm -r --filter='./packages/*' run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
