{
  "name": "@charlie-the-ai/advisor-types",
  "version": "0.1.0",
  "description": "Shared TypeScript data contracts, domain models, and Zod schemas for Charlie the Business Advisor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlie/charlie-the-business-advisor.git",
    "directory": "packages/advisor-types"
  },
  "keywords": [
    "charlie",
    "business-intelligence",
    "analytics",
    "types",
    "zod",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
