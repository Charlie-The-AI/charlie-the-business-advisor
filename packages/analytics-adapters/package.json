{
  "name": "@charlie/analytics-adapters",
  "version": "0.1.0",
  "description": "Data mapping and normalization adapters for Charlie the Business Advisor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlie/charlie-the-business-advisor.git",
    "directory": "packages/analytics-adapters"
  },
  "keywords": [
    "charlie",
    "analytics-adapters",
    "data-normalization",
    "eloquent",
    "data-pipeline"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@charlie/advisor-types": "workspace:*",
    "@charlie/analytics-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
