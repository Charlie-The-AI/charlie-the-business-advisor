{
  "name": "charlie-the-business-advisor",
  "version": "0.1.1",
  "description": "Your AI-Powered Business Growth Companion — Open-Source Business Analytics Engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlie/charlie-the-business-advisor.git",
    "directory": "packages/charlie-the-business-advisor"
  },
  "keywords": [
    "charlie",
    "business-intelligence",
    "analytics",
    "pareto",
    "sales",
    "growth"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@charlie-the-ai/advisor-types": "workspace:*",
    "@charlie-the-ai/analytics-core": "workspace:*",
    "@charlie-the-ai/analytics-adapters": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
