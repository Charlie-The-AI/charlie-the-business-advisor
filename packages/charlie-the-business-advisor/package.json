{
  "name": "charlie-the-business-advisor",
  "version": "0.1.0",
  "description": "Your AI-Powered Business Growth Companion — Open-Source Business Analytics Engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@charlie/advisor-types": "workspace:*",
    "@charlie/analytics-core": "workspace:*",
    "@charlie/analytics-adapters": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
